# ─────────────────────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────────────────────

# Supabase PostgreSQL 연결 문자열.
# - 로컬 개발: Dashboard → Connect 의 직접 연결 URI (db.xxx.supabase.co:5432)
# - Vercel 등 서버리스: Dashboard → Connect → Pooler 탭의 URI (포트 6543) 권장
# [YOUR-DB-PASSWORD] 부분은 URL 인코딩이 필요할 수 있습니다.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.yxryzqzdspmwvibbzxqf.supabase.co:5432/postgres?sslmode=require

# X 이미지 영구 보관 (선택, Supabase Storage)
# 공개 버킷을 만들고 아래 값을 설정하면 X/웹 원본 이미지를 저장해 Notion·공지·뉴스레터에서 재사용합니다.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=xconda-images

# 공개(링크가 있는 모든 사용자: 뷰어)로 공유한 Google Sheet URL
SHEET_URL=https://docs.google.com/spreadsheets/d/1CavwYt1DHE91E1m41gf1TzCDd48HroP0D8YXTgOlsjM/edit?usp=sharing

# ─────────────────────────────────────────────────────────────
# 배포 환경 (Vercel 등 서버리스)
# ─────────────────────────────────────────────────────────────

# 내장 스케줄러(src/instrumentation.ts)는 상시 구동 서버용입니다.
# Vercel 함수는 요청 사이에 멈추므로 내장 스케줄러를 끄고
# 대신 GET /api/cron 을 외부에서 1분 간격으로 호출합니다.
# 자세한 방법은 VERCEL_DEPLOY.md 참고.
DISABLE_SCHEDULER=true

# /api/cron 보호용 시크릿. 설정 시 아래 방식으로 인증합니다.
#   - 쿼리 파라미터: /api/cron?secret=...
#   - 헤더: Authorization: Bearer ...
# Vercel Cron은 CRON_SECRET 환경변수가 있으면 Bearer 헤더를 자동으로 붙여줍니다.
# 생성 예: openssl rand -hex 24
# CRON_SECRET=replace-with-a-long-random-value

# ─────────────────────────────────────────────────────────────
# 메일 발송 (SMTP 또는 Resend 중 하나만 설정)
# ─────────────────────────────────────────────────────────────

# SMTP (예: Gmail 앱 비밀번호)
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=you@example.com

# Resend
# RESEND_API_KEY=re_xxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Xconda — X 게시물 → Gemini 요약 → Notion → 공지 페이지
# (설정 가이드: XCONDA_SETUP.md)
#
# ※ 메일 발송에 집중하는 동안 X 수집은 기본값이 '일시 중단'입니다.
#   다시 사용하려면 관리자 화면의 "X 수집" 페이지에서 자동 실행을 켜세요.
#
# DB 마이그레이션은 아래 순서대로 적용하세요 (Supabase SQL Editor).
#   1) supabase/migrations/20260930000000_xconda.sql       — X 수집 기본 스키마
#   2) supabase/migrations/20261002000000_xconda_ops.sql   — 관제: 마지막 실행 시각/로그
#   3) supabase/migrations/20261006000000_mail_quota.sql   — 하루 발송 한도 + X 수집 일시 중단
# 모든 파일은 여러 번 실행해도 안전합니다. (Drizzle: drizzle/0001 ~ drizzle/0003)
# ─────────────────────────────────────────────────────────────

# Notion integration 토큰 (notion.so/my-integrations 에서 Internal Integration 생성)
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 콘텐츠 DB ID (32자리). 비워두면 관리자 "X 수집" 페이지에서 저장하거나
# "Notion DB 자동 생성" 버튼으로 만들 수 있습니다.
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 Gemini API 키
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 Gemini 모델 (기본값: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# RSSHub 등 RSS 브릿지 주소 (선택). "X 수집" 페이지에서 저장할 수도 있습니다.
# 예: https://rsshub.example.com
# RSSHUB_BASE_URL=
