# ── 메일 발송 (둘 중 하나만 선택) ──────────────────────────
# 1) Gmail / SMTP
# SMTP_USER=you@gmail.com
# SMTP_PASS=앱비밀번호16자리
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=you@gmail.com

