# MAIL_FROM=news@your-domain.com

# ── 스케줄러 ─────────────────────────────────────────────
# 서버리스(Vercel 등)에서 외부 크론 호출 시 인증용
# CRON_SECRET=원하는_긴_문자열
# 인프로세스 스케줄러를 끄려면 true
# DISABLE_SCHEDULER=false
